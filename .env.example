# ==============================================================================
# BHUVISION // SatQuery AI — Environment Configuration
# ==============================================================================

# --- AI Gateway Selection (FreeLLMAPI or OmniRoute) ---
# Option 1: OmniRoute (Port 20128) — 352+ Providers, Antigravity OAuth Gemini, 19 Routing Strategies
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_API_KEY=sk-omniroute-local

# Option 2: FreeLLMAPI (Port 3001) — 34 Free Providers, 7.4B Tokens/mo, Fusion Synthesis
# OPENAI_BASE_URL=http://localhost:3001/v1
# OPENAI_API_KEY=sk-freellmapi-unified

# --- VLM Model Selection ---
VLM_MODEL_NAME=gemini-2.5-flash
# Backend Engine: "gateway" (OmniRoute/FreeLLMAPI), "vllm", or "demo" (deterministic)
VLM_BACKEND=demo

# --- Location & Map Platform Keys ---
# Google Maps Platform (Maps JS, Places, Routes, Elevation)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Mapbox GL (Terrain-DEM 3D, Vector Tiles)
MAPBOX_ACCESS_TOKEN=

# Copernicus Data Space Ecosystem (Sentinel-1 & Sentinel-2 COGs)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# --- Application Server ---
APP_NAME=BHUVISION
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
