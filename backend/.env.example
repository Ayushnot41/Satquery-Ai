# ==============================================================================
# BHUVISION // SatQuery AI — Backend Environment Configuration
# SIH 2026 | Problem SIH26167 | ISRO Mentorship | Team BANKAI
# ==============================================================================

# --- Primary Multi-Agent LLM Gateway: OpenRouter ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=your_openrouter_api_key_here

# --- 9-Agent Dedicated Model Architecture ---
AGENT1_MODEL=meta-llama/llama-3.3-70b-instruct
AGENT2_MODEL=qwen/qwen-2.5-72b-instruct
AGENT3_MODEL=mistralai/mistral-small-3.2-24b-instruct:free
AGENT4_MODEL=google/gemini-2.5-flash
AGENT5_MODEL=deepseek/deepseek-r1-0528:free
AGENT6_MODEL=meta-llama/llama-3.3-70b-instruct
AGENT7_MODEL=deepseek/deepseek-r1:free
AGENT8_MODEL=google/gemini-2.5-flash
AGENT9_MODEL=google/gemini-2.5-flash-lite

# --- VLM Primary Engine ---
VLM_MODEL_NAME=google/gemini-2.5-flash
VLM_BACKEND=gateway

# --- Secondary & Tertiary Fallback Gateways ---
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=sk-omniroute-unified
FREELLM_BASE_URL=http://localhost:3001/v1
# --- Astra / GPT-6 Astra Intelligence Gateway ---
ASTRA_API_KEY=your_astra_gpt6_api_key_here
ASTRA_BASE_URL=https://api.astra.datastax.com/v1

# --- Three Operational Map API Keys ---
# 1. Google Maps Platform (2D/3D Hybrid Photorealistic Tiles)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# 2. MapTiler Cloud (Satellite + Terrain-RGB 3D Elevation)
MAPTILER_API_KEY=your_maptiler_api_key_here

# 3. NASA Earthdata (Authenticated GIBS WMTS Bearer Token)
NASA_EARTHDATA_TOKEN=your_nasa_earthdata_jwt_token_here

# --- Application Server ---
APP_NAME=BHUVISION
APP_VERSION=1.0.0
LOG_LEVEL=INFO
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
